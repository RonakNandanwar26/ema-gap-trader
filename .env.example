# ─── Strategy Config ───
EXTRA_ENTRY_MODE=midtrend
EMA_GAP_MIN=0.03
MAX_HOLD_CANDLES=20
CANDLE_INTERVAL=15
COOLDOWN_CANDLES=3

# ─── Instrument ───
INSTRUMENT=NIFTY

# ─── Capital ───
CAPITAL=100000

# ─── Backtest ───
DHAN_DB_PATH=/path/to/dhan_option_cache.db
BACKTEST_START=2023-04-01
BACKTEST_END=2026-03-28

# ─── Dhan API (for fetching historical backtest data) ───
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ─── Angel One SmartAPI ───
API_KEY=
SECRET_KEY=
CLIENT_ID=
PASSWORD=
TOTP_SECRET=

# ─── WebSocket ───
WS_ENABLED=true
WS_EXIT_CHECK_INTERVAL=2

# ─── Telegram (optional) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Trader daemon (Phase C of AWS deployment refactor) ───
# Set to "remote" to route Paper/Live/Optimized sessions through the
# ema-trader-daemon.service (recommended on prod, keeps trading alive
# across Streamlit restarts and browser refreshes). Leave as "local" to
# use the legacy in-process daemon-thread model.
TRADER_DAEMON_MODE=local
TRADER_DAEMON_URL=http://127.0.0.1:8787
